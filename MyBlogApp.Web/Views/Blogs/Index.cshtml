@model MyBlogApp.Web.Models.Domain.BlogPost
<div class="container">
    <div class="row justify-content-center">
       <div class="col-6 d-flex flex-wrap">
            @if(Model != null && Model.Tags.Any())
            {
                foreach(var tag in Model.Tags)
                {
                    <span class="badge bg-secondary me-2">@tag.Name</span>
                }
            }
        </div>
    </div>
</div>
<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            @if (Model != null)
            {
                <h1 class="mb-3">@Model.Heading</h1>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-secondary">By @Model.Author</span>
                    <span class="text-secondary">@Model.PublishedDate.ToShortDateString()</span>
                </div>
                <img src="@Model.FeaturedImageUrl" alt="Featured Image" class="d-block img-fluid mb-3" />
                <div class="mb-3 d-flex">
                    @foreach(var tag in Model.Tags)
                    {
                        <span class="badge bg-primary me-2">@tag.Name</span>
                    }
                </div>
                <div class="mb-3 blog-details-content">
                    @Html.Raw(Model.Content)
                </div>
            }
            else
            {
                <p>No blog posts available.</p>
            }
        </div>
    </div>
</div>
