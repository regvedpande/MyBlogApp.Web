@model List<MyBlogApp.Web.Models.BlogPost>
@{
    ViewData["Title"] = "Home Page";

    // Author / site metadata
    var siteAuthor = "Regved Pande";
    var siteTitle = "Tech Insights";

    // sample blog data (move to DB/controller when ready)
    var blogPosts = new[]
    {
        new {
            Id = 1,
            Category = ".NET Core",
            Title = "Mastering Dependency Injection in .NET 8",
            Image = "https://images.unsplash.com/photo-1515879218367-8466d910aaa4?w=1200&q=80",
            Content = "Dependency Injection (DI) is at the heart of ASP.NET Core. In this blog, we explore the three service lifetimes: Transient, Scoped, and Singleton. We will look at code examples of how to register services in the Program.cs file and best practices for avoiding memory leaks."
        },
        new {
            Id = 2,
            Category = "Azure Cloud",
            Title = "Hosting Web Apps with Azure App Service",
            Image = "https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=1200&q=80",
            Content = "Azure App Service provides a highly scalable, self-patching web hosting service. This guide covers how to deploy your .NET application using CI/CD pipelines from GitHub Actions directly to Azure."
        },
        new {
            Id = 3,
            Category = "AWS Services",
            Title = "Serverless Architecture with AWS Lambda",
            Image = "https://images.unsplash.com/photo-1484417894907-623942c8ee29?w=1200&q=80",
            Content = "Serverless allows you to build and run applications without thinking about servers. We will discuss how to trigger AWS Lambda functions using C# and how it integrates with API Gateway for cost-effective microservices."
        },
        new {
            Id = 4,
            Category = "Machine Learning",
            Title = "Getting Started with ML.NET",
            Image = "https://images.unsplash.com/photo-1555949963-ff9fe0c870eb?w=1200&q=80",
            Content = "You don't need Python to do Machine Learning. ML.NET allows C# developers to train, build, and ship custom machine learning models. We will build a sentiment analysis tool using .NET."
        },
        new {
            Id = 5,
            Category = "Artificial Intelligence",
            Title = "Integrating OpenAI API in C#",
            Image = "https://images.unsplash.com/photo-1677442136019-21780ecad995?w=1200&q=80",
            Content = "Generative AI is changing the landscape. Learn how to make HTTP requests to the OpenAI API to generate text and images directly within your ASP.NET Core MVC application."
        },
        new {
            Id = 6,
            Category = "DevOps & Architecture",
            Title = "Microservices vs Monoliths",
            // Replace REPLACE_WITH_DIRECT_IMAGE_URL with the direct image URL you copied from Unsplash/Pexels/Freepik
            Image = "REPLACE_WITH_DIRECT_IMAGE_URL",
            Content = "Choosing the right architecture is crucial. We compare the complexity of distributed microservices against the simplicity of monolithic architecture and when to use which."
        }

    };

    // helper to create a short, safe excerpt
    Func<string,int,string> Excerpt = (text, max) =>
    {
        if (String.IsNullOrEmpty(text)) return string.Empty;
        if (text.Length <= max) return text;
        var cut = text.Substring(0, max);
        var lastSpace = cut.LastIndexOf(' ');
        if (lastSpace > 0) cut = cut.Substring(0, lastSpace);
        return cut + "…";
    };
}

<style>
    :root {
        --card-radius: 14px;
        --card-shadow: 0 8px 20px rgba(15,23,42,0.08);
        --accent: #0d6efd;
        --muted: #6c757d;
    }

    .hero {
        padding: 3.25rem 0 2rem;
        text-align: center;
    }

    .hero .lead {
        color: var(--muted);
        font-size: 1.05rem;
    }

    /* Grid behavior */
    .blog-grid { margin-top: 1.75rem; }
    .blog-card {
        border: 0;
        border-radius: var(--card-radius);
        overflow: hidden;
        transition: transform .28s cubic-bezier(.2,.9,.2,1), box-shadow .28s;
        box-shadow: var(--card-shadow);
        background: linear-gradient(180deg, #fff 0%, #fbfcfe 100%);
        height: 100%;
        display: flex;
        flex-direction: column;
    }
    .blog-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 18px 45px rgba(12,18,33,0.12);
    }

    .card-media {
        position: relative;
        min-height: 160px;
        max-height: 260px;
        overflow: hidden;
    }

    .card-media img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform .6s ease;
    }
    .blog-card:hover .card-media img { transform: scale(1.05); }

    .category-pill {
        position: absolute;
        top: 12px;
        left: 12px;
        background: rgba(0,0,0,0.6);
        color: #fff;
        padding: 6px 10px;
        border-radius: 999px;
        font-size: .78rem;
        font-weight: 600;
        backdrop-filter: blur(4px);
    }

    .card-body {
        padding: 1.15rem 1.15rem;
        display: flex;
        flex-direction: column;
        gap: .6rem;
    }

    .card-title {
        font-size: 1.05rem;
        margin: 0;
        line-height: 1.2;
    }

    .card-excerpt {
        color: var(--muted);
        font-size: .92rem;
        flex: 1 1 auto;
    }

    .card-footer {
        padding: .85rem 1.15rem;
        border-top: 1px solid rgba(0,0,0,0.04);
        display:flex;
        align-items:center;
        justify-content:space-between;
        gap: .5rem;
    }

    .author {
        font-size: .88rem;
        color: var(--muted);
    }

    /* Modal tweaks */
    .modal-header {
        border-bottom: 1px solid rgba(0,0,0,0.06);
        background: linear-gradient(90deg,#fff,#f8fbff);
    }
    .modal-body .lead {
        color: var(--muted);
    }
    .key-takeaways li { margin-bottom: .45rem; }

    @@media (max-width: 575px) {
    .card-media { min-height: 140px; }
}

</style>

<section class="hero">
    <div class="container">
        <h1 class="display-5 fw-bold">@siteTitle</h1>
        <p class="lead">Curated articles on .NET, cloud, AI, and modern architecture — practical guides and thoughtful explainers.</p>
    </div>
</section>

<main class="container blog-grid" aria-labelledby="latest-articles">
    <div class="row g-4">
        @foreach (var blog in blogPosts)
        {
            <article class="col-12 col-md-6 col-lg-4" aria-labelledby="post-@blog.Id">
                <div class="card blog-card" role="button" data-bs-toggle="modal" data-bs-target="#blogModal-@blog.Id" aria-controls="blogModal-@blog.Id" tabindex="0" onkeypress="if(event.key==='Enter') this.click();">
                    <figure class="card-media">
                        <span class="category-pill">@blog.Category</span>
                        <img src="@blog.Image"
                             alt="@($"{blog.Title} — {blog.Category}")"
                             loading="lazy"
                             decoding="async"
                             width="1200" height="600">
                    </figure>

                    <div class="card-body">
                        <h3 id="post-@blog.Id" class="card-title">@blog.Title</h3>
                        <p class="card-excerpt">@Html.Raw(Excerpt(blog.Content, 110))</p>

                        <div class="d-flex align-items-center gap-2 mt-2">
                            <small class="author">By <strong class="text-primary">@siteAuthor</strong></small>
                            <small class="text-muted">•</small>
                            <small class="text-muted">Tech • @blog.Category</small>
                        </div>
                    </div>

                    <div class="card-footer">
                        <small class="text-muted">Read more</small>
                        <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#blogModal-@blog.Id" aria-label="Open @blog.Title">Open</button>
                    </div>
                </div>
            </article>

            <!-- Modal -->
            <div class="modal fade" id="blogModal-@blog.Id" tabindex="-1" aria-labelledby="modalLabel-@blog.Id" aria-hidden="true">
                <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
                    <div class="modal-content">
                        <div class="modal-header">
                            <div>
                                <h5 class="modal-title fw-bold" id="modalLabel-@blog.Id">@blog.Title</h5>
                                <small class="text-muted">@blog.Category — by @siteAuthor</small>
                            </div>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close dialog"></button>
                        </div>

                        <div class="modal-body">
                            <div class="row gx-4">
                                <div class="col-12 col-lg-6 mb-3">
                                    <img src="@blog.Image" alt="@blog.Title" class="img-fluid rounded" style="width:100%; height:320px; object-fit:cover;">
                                </div>
                                <div class="col-12 col-lg-6">
                                    <p class="lead mb-2">@Excerpt(blog.Content, 220)</p>
                                    <p class="mb-1"><strong>Category:</strong> <span class="badge bg-light text-dark">@blog.Category</span></p>
                                    <p class="mb-0"><strong>Author:</strong> @siteAuthor</p>
                                </div>
                            </div>

                            <hr>

                            <section aria-label="Article body" class="mb-3">
                                <h6 class="mb-2">Introduction</h6>
                                <p>@blog.Content</p>
                            </section>

                            <section aria-label="Key takeaways" class="mb-3">
                                <h6 class="mb-2">Key takeaways</h6>
                                <ul class="key-takeaways">
                                    <li>Understand the essentials of <strong>@blog.Category</strong>.</li>
                                    <li>Practical steps and best practices to apply in your projects.</li>
                                    <li>Performance and scaling considerations for production.</li>
                                </ul>
                            </section>

                            <section aria-label="Further reading">
                                <h6 class="mb-2">Further reading</h6>
                                <p class="mb-0"><em>Expand this section with links to code samples, GitHub repositories, or related posts.</em></p>
                            </section>
                        </div>

                        <div class="modal-footer justify-content-between">
                            <small class="text-muted">Published by <strong>@siteAuthor</strong></small>
                            <div>
                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                                <a href="#" class="btn btn-primary ms-2">View full post</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</main>
