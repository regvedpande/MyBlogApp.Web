@model MyBlogApp.Web.Models.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Home Page";
}
<div class="container py-5">
    <h1 class="mb-4">Latest Blog Posts</h1>
    @if (Model.BlogPosts != null && Model.BlogPosts.Any())
    {
        foreach (var blogPost in Model.BlogPosts)
        {
            <div class="card mb-4">
                <div class="card-body">
                    <h2 class="card-title">@blogPost.Heading</h2>
                    <p class="card-text">@blogPost.ShortDescription</p>
                    <a asp-controller="Blogs" asp-action="Index" asp-route-urlHandle="@blogPost.UrlHandle" class="btn btn-primary">Read More</a>
                </div>
            </div>
        }
    }
    else
    {
        <p>No blog posts available.</p>
    }
</div>
