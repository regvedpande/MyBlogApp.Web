@model MyBlogApp.Web.Models.ViewModels.HomeViewModel
@using System.Text.RegularExpressions
@{
    ViewData["Title"] = "Stories for curious builders";
    var posts = Model.BlogPosts?.Where(post => post.Visible).OrderByDescending(post => post.PublishedDate).ToList() ?? [];
    var featured = posts.FirstOrDefault();
    var categories = posts.SelectMany(post => post.Tags ?? []).Select(tag => tag.DisplayName ?? tag.Name).Distinct().OrderBy(tag => tag).ToList();
}

<section class="blog-hero mb-5">
    <span class="eyebrow">THE MYBLOG JOURNAL</span>
    <h1>Ideas for building better<br class="d-none d-md-block" /> digital products.</h1>
    <p>Practical notes on engineering, design, delivery, and the craft behind thoughtful software.</p>
</section>

@if (featured is not null)
{
    <section class="featured-post mb-5" data-blog-card data-title="@featured.Heading" data-description="@featured.ShortDescription" data-tags="@string.Join(" ", featured.Tags?.Select(tag => tag.DisplayName ?? tag.Name) ?? [])">
        <img src="@featured.FeaturedImageUrl" alt="Illustration for @featured.Heading" />
        <div class="featured-copy">
            <span class="eyebrow">FEATURED STORY</span>
            <h2>@featured.Heading</h2>
            <p>@featured.ShortDescription</p>
            <div class="post-meta"><span>@featured.PublishedDate.ToString("MMM d, yyyy")</span><span>·</span><span>@GetReadingTime(featured.Content) min read</span></div>
            <a asp-controller="Blogs" asp-action="Index" asp-route-urlHandle="@featured.UrlHandle" class="btn btn-dark mt-3">Read the story <span aria-hidden="true">→</span></a>
        </div>
    </section>
}

<section aria-labelledby="latest-stories">
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-end gap-3 mb-4">
        <div><span class="eyebrow">EXPLORE</span><h2 id="latest-stories" class="section-title mb-0">Latest stories</h2></div>
        <label class="blog-search"><span aria-hidden="true">⌕</span><span class="visually-hidden">Search stories</span><input id="blog-search" type="search" placeholder="Search stories..." aria-controls="blog-grid" /></label>
    </div>
    <div class="filter-pills mb-4" role="group" aria-label="Filter stories by topic">
        <button class="active" type="button" data-blog-filter="all" aria-pressed="true">All</button>
        @foreach (var category in categories.Take(8)) { <button type="button" data-blog-filter="@category.ToLowerInvariant()" aria-pressed="false">@category</button> }
    </div>
    <div class="row g-4" id="blog-grid">
        @if (featured is not null)
        {
            <article class="col-12 col-md-6 col-lg-4" data-blog-card data-title="@featured.Heading" data-description="@featured.ShortDescription" data-tags="@string.Join(" ", featured.Tags?.Select(tag => tag.DisplayName ?? tag.Name) ?? [])">
                <div class="story-card h-100">
                    <a asp-controller="Blogs" asp-action="Index" asp-route-urlHandle="@featured.UrlHandle" class="story-image"><img src="@featured.FeaturedImageUrl" alt="Illustration for @featured.Heading" loading="lazy" /></a>
                    <div class="story-body">
                        <div class="story-tags">@foreach (var tag in featured.Tags?.Select(tag => tag.DisplayName ?? tag.Name).Take(2) ?? []) { <span>@tag</span> }</div>
                        <h3><a asp-controller="Blogs" asp-action="Index" asp-route-urlHandle="@featured.UrlHandle">@featured.Heading</a></h3>
                        <p>@featured.ShortDescription</p>
                        <div class="post-meta mt-auto"><span>@featured.PublishedDate.ToString("MMM d, yyyy")</span><span>·</span><span>@GetReadingTime(featured.Content) min read</span></div>
                    </div>
                </div>
            </article>
        }
        @foreach (var post in posts.Skip(featured is null ? 0 : 1))
        {
            var tagNames = post.Tags?.Select(tag => tag.DisplayName ?? tag.Name).ToList() ?? [];
            <article class="col-12 col-md-6 col-lg-4" data-blog-card data-title="@post.Heading" data-description="@post.ShortDescription" data-tags="@string.Join(" ", tagNames)">
                <div class="story-card h-100">
                    <a asp-controller="Blogs" asp-action="Index" asp-route-urlHandle="@post.UrlHandle" class="story-image"><img src="@post.FeaturedImageUrl" alt="Illustration for @post.Heading" loading="lazy" /></a>
                    <div class="story-body">
                        <div class="story-tags">@foreach (var tag in tagNames.Take(2)) { <span>@tag</span> }</div>
                        <h3><a asp-controller="Blogs" asp-action="Index" asp-route-urlHandle="@post.UrlHandle">@post.Heading</a></h3>
                        <p>@post.ShortDescription</p>
                        <div class="post-meta mt-auto"><span>@post.PublishedDate.ToString("MMM d, yyyy")</span><span>·</span><span>@GetReadingTime(post.Content) min read</span></div>
                    </div>
                </div>
            </article>
        }
    </div>
    <p id="blog-empty" class="blog-empty d-none" role="status" aria-live="polite">No stories match that search. Try another topic.</p>
</section>

@functions {
    private static int GetReadingTime(string? html) => Math.Max(1, (int)Math.Ceiling(Regex.Replace(html ?? "", "<.*?>", " ").Split(' ', StringSplitOptions.RemoveEmptyEntries).Length / 200d));
}

@section Scripts { <script src="~/js/site.js" asp-append-version="true"></script> }
