@{
    ViewData["Title"] = "Blog Posts List";
}

<div class="bg-secondary bg-opacity-10 py-2">
    <div class="container">
        <h1>Blog Posts - Admin Functionality</h1>
    </div>
</div>

<div class="container py-5">
    <div class="row justify-content-end">
      <div class="col-auto">
            <a class="btn btn-primary" asp-area="" asp-controller="AdminBlogPosts" asp-action="Add">Add Blog Post</a>
      </div>
    </div>

    <div class="row mt-4">
      <div class="col">
   <!-- Table will be populated with blog posts data once we implement it -->
        <table class="table">
 <thead>
          <tr>
               <th>Title</th>
          <th>Short Description</th>
            <th>Author</th>
                <th>Published Date</th>
   <th>Visible</th>
        <th>Actions</th>
           </tr>
 </thead>
 <tbody>
    <!-- Blog posts will be listed here -->
      </tbody>
            </table>
        </div>
    </div>
</div>